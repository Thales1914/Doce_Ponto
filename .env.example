# Copie para .env (nunca commitar o .env) e ajuste os valores.

# --- API ---
# Porta publicada no host (dentro do container a API sempre escuta na 3000)
API_PORT=3000
# Segredo de assinatura do JWT. Gere um valor longo e aleatório, ex.: openssl rand -hex 32
JWT_SECRET=troque-por-um-segredo-longo-e-aleatorio
JWT_EXPIRES_IN=8h
# Origens permitidas no CORS, separadas por vírgula ("*" libera qualquer origem — só para desenvolvimento)
CORS_ORIGIN=*
# Fuso usado nos cálculos de data (dashboard, datas padrão)
APP_TIMEZONE=America/Sao_Paulo

# --- Administradora inicial (criada no primeiro boot se ainda não existir) ---
ADMIN_NOME=Administradora
ADMIN_EMAIL=admin@doces.local
ADMIN_SENHA=troque-esta-senha

# --- PostgreSQL ---
POSTGRES_USER=doces
POSTGRES_PASSWORD=doces_dev_password
POSTGRES_DB=doces
# Porta publicada no host para acessar o banco com ferramentas externas
DB_HOST_PORT=5432
# Opcional: em deploy com banco gerenciado, DATABASE_URL tem prioridade sobre as variáveis acima
# DATABASE_URL=postgres://usuario:senha@host:5432/banco
