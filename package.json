{
  "name": "sistema-doces-backend",
  "version": "1.0.0",
  "description": "DocePonto — fase 2: API Express, PostgreSQL e autenticação administrativa com JWT",
  "main": "src/server.js",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env src/server.js",
    "dev": "node --watch --env-file-if-exists=.env src/server.js",
    "migrate": "node --env-file-if-exists=.env src/db/migrate.js",
    "test": "node --test --test-concurrency=1 \"tests/**/*.test.js\"",
    "test:local": "node --env-file=.env --test --test-concurrency=1 \"tests/**/*.test.js\""
  },
  "license": "UNLICENSED",
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.0",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "pg": "^8.23.0",
    "swagger-ui-express": "^5.0.1",
    "yaml": "^2.9.1",
    "zod": "^4.6.5"
  }
}
